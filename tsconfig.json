{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
   "lib": ["ES2020", "dom", "dom.iterable", "ES2020", "ESNext", "ES2015", "ES2016", "ES2017", "ES2018", "ES2019"],
   "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
